# Build context MUST be the MicroservicesArchitecture-Web/ repo root (not this folder).
# Build with: docker build -f apps/nasheed/admin/Dockerfile .
FROM node:22-alpine AS build
# node:22-alpine ships npm 10.x, but package-lock.json is generated by npm 11 (local dev
# machine) — npm ci's lockfile-match check isn't identical across major npm versions, so
# the same lockfile that passes locally can fail here with "Missing: X from lock file".
RUN npm install -g npm@11
WORKDIR /workspace
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npx nx build nasheed-admin --configuration=docker

FROM nginx:alpine AS final
COPY --from=build /workspace/dist/apps/nasheed/admin/browser /usr/share/nginx/html
COPY apps/nasheed/admin/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
